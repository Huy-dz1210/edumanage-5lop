# Sao chép file này thành .env rồi chỉnh sửa
PORT=3000
NODE_ENV=development
# BẮT BUỘC đổi khi triển khai thật (chuỗi ngẫu nhiên dài)
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai
# Đặt true khi chạy sau HTTPS
COOKIE_SECURE=false
# Số giờ giữa các lần sao lưu tự động và số bản giữ lại
AUTO_BACKUP_HOURS=6
MAX_BACKUPS=10
