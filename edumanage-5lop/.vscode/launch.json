{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Chạy EduManage (debug)",
      "program": "${workspaceFolder}/src/server.js",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": { "PORT": "3000" }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Chạy kiểm thử API",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test"],
      "console": "integratedTerminal"
    }
  ]
}
